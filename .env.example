# API Server Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://fashion_user:fashion_pass@localhost:5432/fashion_db

# MinIO / S3 Storage Configuration
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021
MINIO_ENDPOINT=localhost:9020
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_RAW_BUCKET=raw-images
MINIO_CROPS_BUCKET=crops

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STAGE1=fashion.jobs.stage1
KAFKA_TOPIC_STAGE2=fashion.jobs.stage2
KAFKA_TOPIC_DLQ=fashion.jobs.dlq
KAFKA_GROUP_ID=fashion-gpu-workers

# Machine Learning & Inference
DEVICE=cpu
TAXONOMY_PATH=data/deepfashion_taxonomy.json
MIN_MASK_PIXELS=500
MAX_RETRIES=3
YOLO_MODEL_PATH=yolov8n.pt
SAM_CHECKPOINT_PATH=sam_vit_b_01ec64.pth
SAM_MODEL_TYPE=vit_b
ENABLE_PERSON_DETECTION=true
ENABLE_LAYER_SPLITTING=true
